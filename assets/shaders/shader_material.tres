[ext_resource type="Texture2D" uid="uid://c32mecxfvaoad" path="res://textures/john.png" id="2_5juko"]
[ext_resource type="Texture2D" uid="uid://dlihtshu6pcmx" path="res://assets/shaders/squiggle_noise.tres" id="2_js8f1"]

[sub_resource type="Shader" id="Shader_js8f1"]
code = "shader_type spatial;

render_mode vertex_lighting, cull_disabled, specular_disabled;

uniform sampler2D input_texture : filter_nearest;

uniform vec3 black_color : source_color;
uniform vec3 red_color : source_color;

uniform float emission_mult = 0.0;

uniform vec2 uv_mult = vec2(10,10);
uniform vec2 uv_scroll = vec2(0,0);

group_uniforms Squiggle;
uniform bool squiggle = false;
/**
 * Noise texture scale
 * By default, the noise texture's size in world coordinates is set by its resolution
*/
uniform vec2 scale = vec2(1.0);
uniform float strength = 0.1;
/**
 * Number of squiggle frames per second
*/
uniform float fps = 6.0;
uniform sampler2D noise : filter_linear, repeat_enable;
group_uniforms;

varying vec4 modulate;
varying vec2 noise_uv;

void vertex() {
	// Called for every vertex the material is visible on.
	modulate = COLOR;
	if (squiggle){
		// Use world coordinates for scale-independent squiggles, offset by position to keep pattern attached to object
	noise_uv = (vec2(textureSize(noise, 0)) * scale);
	}
	
}
// Use irrational constants for unique squiggles every frame
#define offset_multiplier vec2(PI, E)

void fragment() {
	vec2 squiggle_uv = SCREEN_UV;
	if (squiggle){
		// Called for every pixel the material is visible on.
		vec2 noise_offset = vec2(floor(TIME * fps)) * offset_multiplier;
		float noise_sample = texture(noise, noise_uv + noise_offset).r * 4.0 * PI;
		vec2 direction = vec2(cos(noise_sample), sin(noise_sample));
		squiggle_uv = SCREEN_UV + direction * strength * 0.005;
		}
	
	
	ALBEDO = mix(black_color, red_color, texture(input_texture, squiggle_uv * uv_mult + (uv_scroll * TIME)).x);
	ALPHA = texture(input_texture, squiggle_uv * uv_mult).a;
	ALPHA_SCISSOR_THRESHOLD = 0.1;
	ALPHA_ANTIALIASING_EDGE = 0.8;
	//Use this if squiggle sucks
	//ALBEDO = mix(black_color, red_color, texture(input_texture, UV * uv_mult).x);
	ANISOTROPY = 0.0;
	EMISSION = ALBEDO * emission_mult;
}
"

[resource]
render_priority = 0
shader = SubResource("Shader_js8f1")
shader_parameter/input_texture = ExtResource("2_5juko")
shader_parameter/black_color = Color(0, 0, 0, 1)
shader_parameter/red_color = Color(0.7587979, 0.47082222, 0, 1)
shader_parameter/emission_mult = 4.82
shader_parameter/uv_mult = Vector2(10, 10)
shader_parameter/uv_scroll = Vector2(0, 0)
shader_parameter/squiggle = false
shader_parameter/scale = Vector2(1, 1)
shader_parameter/strength = 0.5
shader_parameter/fps = 6.0
shader_parameter/noise = ExtResource("2_js8f1")
